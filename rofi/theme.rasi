
* {
    bg0:    #1e1e2e;   // nền chính
    bg1:    #313244;   // nền phụ
    bg2:    #1e1e2e;   // nền nhấn
    bg3:    #1e1e2e;   // accent xanh
    fg0:    #cdd6f4;   // chữ chính
    fg1:    #1e1e2e;   // trắng sáng
    fg2:    #cdd6f4;   // chữ phụ
    fg3:    #cdd6f4;   // chữ xám
}

